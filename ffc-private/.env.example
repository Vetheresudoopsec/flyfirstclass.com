# Copy this file to a new file named ".env" in the same folder (ffc-private) and fill in your own values.
# NEVER put .env in git. It stays on the server only (cPanel File Manager > ffc-private > + File > .env).

# ---- Required ----
DUFFEL_TOKEN=duffel_live_paste_your_token_here
AIRLABS_KEY=paste_your_airlabs_key_here

# ---- Photos (optional but recommended) ----
UNSPLASH_KEY=paste_your_unsplash_access_key_here
#PHOTO_CREDITS=off            # "off" hides the photographer credit under photos

# ---- Protects the checking pages (/api/status, /api/duffel-check, /api/mail-check, /api/photo-test, /api/cron) ----
# Choose a long random phrase. Open them like https://yourdomain.com/api/status?key=THE_PHRASE
ADMIN_KEY=choose-a-long-random-phrase

# ---- Email ----
# Quote requests are emailed to quote@flyfirstclass.com. Set MAIL_TO only if you want them delivered to a different inbox.
#MAIL_TO=quote@flyfirstclass.com
#MAIL_FROM=quote@flyfirstclass.com     # must be a mailbox that exists in cPanel > Email Accounts
# Visitors who send a new quote request with a route also get a "Thank you for your request" email. "off" stops that.
#CUSTOMER_CONFIRMATION=off
# By default the server's own mail system is used (works on HostGator once the mailbox above exists).
# If you would rather use Gmail or another service, fill these in and it will be used instead:
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=465                  # 465 = SSL, 587 = STARTTLS
#SMTP_SECURE=ssl                # ssl, starttls or none (guessed from the port if left out)
#SMTP_USER=you@gmail.com
#SMTP_PASS=your_app_password

# ---- Bot protection (on by default, nobody is ever asked to pick pictures or type text) ----
# Optional extra: Cloudflare Turnstile. In Cloudflare > Turnstile > Add widget, choose widget mode "Invisible", add your domain, then paste both keys:
#TURNSTILE_SITE_KEY=paste_the_site_key_here
#TURNSTILE_SECRET=paste_the_secret_key_here
#BOT_GUARD=off                  # "off" turns all bot checks off (only for testing)
#GUARD_TTL=1800                 # seconds a visitor's pass stays valid
#SITE_HOSTS=www.flyfirstclass.com   # extra host names allowed to call the API (the site's own address is always allowed)

# ---- Manage Booking page: request history (find requests by email or phone, after an emailed 6-digit code) ----
#REQUEST_HISTORY=off            # "off" turns request history off (on by default)

# ---- Newsletter (Mailchimp). Until both lines are filled in, sign-ups are held safely on the server ----
# API key: Mailchimp > profile > Extras > API keys. It ends with a data centre code such as -us21 (used automatically).
# Audience ID: Mailchimp > Audience > Settings > Audience name and defaults.
#MAILCHIMP_API_KEY=paste_your_key_here-us21
#MAILCHIMP_LIST_ID=paste_your_audience_id_here
MAILCHIMP_DOUBLE_OPTIN=off     # "off" subscribes people straight away (Privacy Policy clause 2.3 describes this); "on" makes Mailchimp send a confirmation link first (then change clause 2.3)
#MAILCHIMP_TAG=Website newsletter   # tag given to everyone who joins here; "none" = no tags

# ---- Optional tuning (the defaults are fine) ----
#DUFFEL_RPM=40                  # Duffel searches per minute across the whole site
#DUFFEL_DAILY_CAP=1000          # stop sending searches after this many in one day (0 = no cap)
#NEW_ROUTES_PER_IP_HOUR=80      # new route lookups one visitor can trigger per hour
#TASKS_PER_REQUEST=6            # routes one page request may fetch before answering "pending"
#WARM_PER_RUN=6                # routes the cron job looks up with Duffel per run to price carousel cards (your price-sheet routes first)
#CRON_BUDGET=240                # seconds one cron run may work
#TRUST_PROXY=on                 # only if the site sits behind Cloudflare or another proxy (so each visitor's own address is used)
